      "year": 1904,
      "title": "The Oldest Relic in Korea",
      "source_url": "https://anthony.sogang.ac.kr/KoreaReview/KoreaReviewVolume4-06.docx",
      "status": "provisional_source_boundary_candidate_not_verified",
